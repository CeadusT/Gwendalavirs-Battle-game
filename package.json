{
  "name": "gwendalavirs-battle-game",
  "productName": "Gwendalavir's Battle",
  "version": "0.2.0",
  "description": "Logiciel pour jouer à Gwendalavir's Battle, le TCG.",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "gg.gwendalavirs.battle",
    "productName": "Gwendalavir's Battle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.card-games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "extraResources": [
      {
        "from": "src/assets/fonts/LICENCE.txt",
        "to": "LICENCE-polices.txt"
      }
    ]
  }
}
